LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

OPENAI_API_KEY=your-openai-api-key
SARVAM_API_KEY=your-sarvam-api-key

# Optional model and voice overrides
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-live-transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=shubh

# Optional source integrations; missing keys disable the corresponding lookup
TAVILY_API_KEY=
INDIAN_KANOON_API_TOKEN=
AGENT_MAX_OUTPUT_TOKENS=600
